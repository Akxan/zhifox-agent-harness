# 把这个文件复制一份，命名为 .env，然后填入至少一家的 API key。
# 也可以不动这个文件：运行 uv run harness --web ，在网页界面的设置里填写，效果是一样的。
# .env 已经写进 .gitignore，不会被提交到 git。

# Claude：https://platform.claude.com
ANTHROPIC_API_KEY=

# GPT：https://platform.openai.com
OPENAI_API_KEY=

# Gemini：https://aistudio.google.com
GEMINI_API_KEY=

# DeepSeek：https://platform.deepseek.com
DEEPSEEK_API_KEY=

# ---- 以下都是可选项，去掉行首的 # 即可生效 ----

# 每条消息最多联网搜索几次（只有 Claude 能联网搜索）。0 表示不限制。默认 5。
# HARNESS_MAX_SEARCHES=5

# 设为 0 可以完全关闭联网搜索。
# HARNESS_WEB=0

# Claude 思考的力度：low / medium / high / xhigh / max。越高越仔细，也越慢越贵。默认 medium。
# HARNESS_EFFORT=medium
